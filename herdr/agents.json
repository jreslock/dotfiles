{
  "claude": {
    "kind": "claude",
    "description": "Claude Code on your normal login (e.g. Claude Teams)"
  },
  "claude-bedrock": {
    "kind": "claude",
    "args": [
      "--model",
      "opus"
    ],
    "description": "Claude Code, Opus 5.5 on Bedrock (us. profiles)",
    "bedrock": true,
    "env": {
      "CLAUDE_CODE_USE_BEDROCK": "1",
      "AWS_REGION": "us-east-1",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-5-5",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-5-5",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-5-5",
      "ANTHROPIC_DEFAULT_FABLE_MODEL": "us.anthropic.claude-fable-5-1"
    }
  },
  "luna": {
    "kind": "codex",
    "args": [
      "-p",
      "luna"
    ],
    "description": "Codex, GPT-5.6 Luna on Bedrock (fast/cheap)",
    "bedrock": true
  },
  "terra": {
    "kind": "codex",
    "args": [
      "-p",
      "terra"
    ],
    "description": "Codex, GPT-5.6 Terra on Bedrock (everyday)",
    "bedrock": true
  },
  "sol": {
    "kind": "codex",
    "args": [
      "-p",
      "sol"
    ],
    "description": "Codex, GPT-5.6 Sol on Bedrock (hard multi-step)",
    "bedrock": true
  },
  "astra": {
    "kind": "codex",
    "args": [
      "-p",
      "astra"
    ],
    "description": "Codex, GPT-6 Astra on Bedrock (frontier)",
    "bedrock": true
  },
  "kiro": {
    "kind": "kiro",
    "description": "Kiro CLI on your Kiro login (model picked in Kiro)"
  }
}
