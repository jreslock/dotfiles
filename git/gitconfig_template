# Shared git configuration, tracked in the dotfiles repo.
#
# This file is meant to be *included* by a real ~/.gitconfig (see `setup`),
# NOT symlinked to it. Keep it free of machine-specific state: credential
# helpers live in ~/.gitconfig so that `gh auth setup-git` writes stay local
# instead of dirtying this tracked file. Identity lives here so ephemeral
# machines (devenv rebuilds recreate ~/.gitconfig) always have it; a
# machine-specific override still wins via `git config --global user.email`.

[user]
    name     = Jason Reslock
    email    = jreslock@users.noreply.github.com

[core]
	editor   = vim
	pager    = less -F

[color]
    ui       = auto

[push]
    default  = current
    autoSetupRemote = true

[init]
    defaultBranch = main

[rerere]
    enabled  = true

[pull]
    rebase   = true

[alias]
    ignore	 = "!gi() { curl -L -s https://www.gitignore.io/api/$@ ;}; gi"

[fetch]
    prune	 = true

[diff]
	tool     = vimdiff

[merge]
    tool	 = vimdiff
    conflictStyle = zdiff3

[commit]
    verbose  = true
