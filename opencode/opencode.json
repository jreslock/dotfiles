{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "bedrock"
      }
    },
    "bedrock-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bedrock (OpenAI-compatible)",
      "options": {
        "baseURL": "https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1",
        "apiKey": "{env:AWS_BEARER_TOKEN_BEDROCK}"
      },
      "models": {}
    }
  }
}
